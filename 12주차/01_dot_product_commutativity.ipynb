   "source": [
    "import numpy as np\n",
    "\n",
    "u = np.array([[2], [-5], [-1]])\n",
    "v = np.array([[3], [2], [-3]])\n",
    "\n",
    "# .T: 전치, @: 행렬곱, .item(): 숫자 하나 추출\n",
    "u_dot_v = (u.T @ v).item()\n",
    "v_dot_u = (v.T @ u).item()\n",
    "\n",
    "print(\"u · v =\", u_dot_v)  # -1\n",
    "print(\"v · u =\", v_dot_u)  # -1\n",
    "print(\"교환법칙 확인:\", u_dot_v == v_dot_u)  # True\n"
   ]
  }
 ],
